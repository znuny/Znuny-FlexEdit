<div class="FlexEditEditor" data-flexedit-editor="[% Data.Field | html %]">
    <div class="FlexEditInput">
        [% Data.Selection %]
        <button type="button" class="FlexEditUndo" title="[% Translate("Reset field") | html %]" aria-label="[% Translate("Reset field") | html %]"><i class="fa fa-undo" aria-hidden="true"></i></button>
    </div>
[% RenderBlockStart("Pending") %]
    <div class="FlexEditPending Hidden">
        <label>[% Translate("Pending date") | html %]:</label>
        <div class="Field">
            <div class="select-field-wrapper FlexEditPendingDate">[% Data.DateString %]</div>
        </div>
    </div>
[% RenderBlockEnd("Pending") %]
</div>
