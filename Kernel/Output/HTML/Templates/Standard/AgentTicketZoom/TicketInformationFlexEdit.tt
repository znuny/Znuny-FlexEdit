# ---
# Znuny-FlexEdit
# ---
#<div class="mod modSidebarWidget">
<div class="mod modSidebarWidget[% IF Data.FlexEditActive %] FlexEditSidebarWidget[% END %]">
# ---
    <div class="inner">
        <div class="sidebarWidgetTitle">
            <h3>[% Translate(Data.WidgetTitle) | html %]</h3>
# ---
# Znuny-FlexEdit
# ---
            [% IF Data.FlexEditActive %]
            <div class="FlexEditHeaderActions Hidden">
                <button type="button" class="FlexEditDiscard" title="[% Translate("Discard changes") | html %]" aria-label="[% Translate("Discard changes") | html %]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                </button>
                <button type="button" class="FlexEditSaveAll" title="[% Translate("Save changes") | html %]" aria-label="[% Translate("Save changes") | html %]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M20 6 9 17l-5-5"/>
                    </svg>
                </button>
            </div>
            [% END %]
# ---
        </div>
        <div class="sidebarWidgetContent">
# ---
# Znuny-FlexEdit
# ---
#            <div class="mod modTicketInformation">
            <div class="mod modTicketInformation[% IF Data.FlexEditActive %] FlexEditWidget[% END %]"[% IF Data.FlexEditActive %] data-flexedit-ticketid="[% Data.TicketID | html %]"[% END %]>
# ---
                <div class="inner">
                    <div class="information-widget">
                        <div class="Content">
                            <fieldset class="TableLike FixedLabelSmall Narrow">
# ---
# Znuny-FlexEdit
# ---
# Age, created and created by are shown first, so that all editable attributes are next to each other.
                                <span>
                                    <label>[% Translate("Age") | html %]:</label>
                                    <p class="Value" title="[% Data.Age %]">[% Data.Age %]</p>
                                </span>

                                <span>
                                    <label>[% Translate("Created") | html %]:</label>
                                    <p class="Value" title="[% Data.Created | Localize("TimeShort") %]">[% Data.Created | Localize("TimeShort") %]</p>
                                </span>

                                [% RenderBlockStart("CreatedBy") %]
                                <span>
                                        <label>[% Translate("Created by") | html %]:</label>
                                        <p class="Value" title="[% Data.CreatedByUser %]">[% Data.CreatedByUser %]</p>
                                    </span>
                                [% RenderBlockEnd("CreatedBy") %]
# ---

                                [% RenderBlockStart("ArchiveFlag") %]
                                <span>
                                        <label>[% Translate("Archive") | html %]:</label>
                                        <p class="Value">[% Translate("This ticket is archived.") | html %]</p>
                                    </span>
                                [% RenderBlockEnd("ArchiveFlag") %]

                                [% RenderBlockStart("Type") %]
# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                        <label>[% Translate("Type") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                        <p class="Value FixedValueSmall" title="[% Data.Type | html %]">[% Data.Type | html %]
#                                        </p>
#                                    </span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="Type"[% END %][% IF Data.FlexEditType %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                        <label>[% Translate("Type") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                        <p class="Value FixedValueSmall[% IF Data.FlexEditType %] FlexEditable[% END %]" title="[% Data.Type | html %]"[% IF Data.FlexEditType %] data-flexedit-field="Type" data-flexedit-value="[% Data.TypeID | html %]"[% END %]>[% Data.Type | html %]
                                        </p>
                                    </span>
# ---
                                [% RenderBlockEnd("Type") %]

# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                    <label>[% Translate("Age") | html %]:</label>
#                                    <p class="Value" title="[% Data.Age %]">[% Data.Age %]</p>
#                                </span>
#
#                                <span>
#                                    <label>[% Translate("Created") | html %]:</label>
#                                    <p class="Value" title="[% Data.Created | Localize("TimeShort") %]">[% Data.Created | Localize("TimeShort") %]</p>
#                                </span>
#
#                                [% RenderBlockStart("CreatedBy") %]
#                                <span>
#                                        <label>[% Translate("Created by") | html %]:</label>
#                                        <p class="Value" title="[% Data.CreatedByUser %]">[% Data.CreatedByUser %]</p>
#                                    </span>
#                                [% RenderBlockEnd("CreatedBy") %]
#                                <span class="state">
#                                    <label>[% Translate("State") | html %]: [% IF Data.StateValidID != 1 %] <em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                    <span class="Value [% Data.PillClass | html %]" title="[% Translate(Data.State) | html %]">
#                                        [% Translate(Data.State) | html %]
#                                    </span>
#                                </span>
                                <span class="state[% IF Data.FlexEditState %] FlexEditableRow[% END %]"[% IF Data.FlexEditActive %] data-flexedit-row="State"[% END %][% IF Data.FlexEditState %] tabindex="0" role="button"[% END %]>
                                    <label>[% Translate("State") | html %]: [% IF Data.StateValidID != 1 %] <em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                    <span class="Value [% Data.PillClass | html %][% IF Data.FlexEditState %] FlexEditable[% END %]" title="[% Translate(Data.State) | html %]"[% IF Data.FlexEditState %] data-flexedit-field="State" data-flexedit-value="[% Data.StateID | html %]"[% END %]>
                                        [% Translate(Data.State) | html %]
                                    </span>
                                </span>
# ---

                                [% RenderBlockStart("PendingUntil") %]
# ---
# Znuny-FlexEdit
# ---
#                                <span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="PendingUntil"[% END %]>
# ---
                                        <label>[% Translate("Pending till") | html %]:</label>
                                        <p class="Value [% Data.PendingUntilClass | html %]">
                                            [% Data.PendingUntil %]
                                            <br/>
                                            [% Data.UntilTimeHuman | Localize("TimeShort") %]
                                        </p>
                                    </span>
                                [% RenderBlockEnd("PendingUntil") %]
# ---
# Znuny-FlexEdit
# ---
                                [% IF Data.FlexEditActive && !Data.FlexEditPendingShown %]<span class="Hidden" data-flexedit-row="PendingUntil"></span>[% END %]
# ---

# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                    <label>[% Translate("Locked") | html %]:</label>
#                                    <p class="Value" title="[% Translate(Data.Lock) | html %]">[% Translate(Data.Lock) | html %]</p>
#                                </span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="Lock"[% END %][% IF Data.FlexEditLock %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                    <label>[% Translate("Locked") | html %]:</label>
                                    <p class="Value[% IF Data.FlexEditLock %] FlexEditable[% END %]" title="[% Translate(Data.Lock) | html %]"[% IF Data.FlexEditLock %] data-flexedit-field="Lock" data-flexedit-value="[% Data.Lock | html %]"[% END %]>[% Translate(Data.Lock) | html %]</p>
                                </span>
# ---


# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                    <label>[% Translate("Priority") | html %]: [% IF Data.PriorityValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                    <p class="Value" title="[% Translate(Data.Priority) | html %]">[% Translate(Data.Priority) | html %]</p>
#                                </span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="Priority"[% END %][% IF Data.FlexEditPriority %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                    <label>[% Translate("Priority") | html %]: [% IF Data.PriorityValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                    <p class="Value[% IF Data.FlexEditPriority %] FlexEditable[% END %]" title="[% Translate(Data.Priority) | html %]"[% IF Data.FlexEditPriority %] data-flexedit-field="Priority" data-flexedit-value="[% Data.PriorityID | html %]"[% END %]>[% Translate(Data.Priority) | html %]</p>
                                </span>
# ---

# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                    <label>[% Translate("Queue") | html %]:[% IF Data.QueueValidID != 1 %] <em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                    <p class="Value" title="[% Data.Queue | html %]">[% Data.Queue | html %]</p>
#                                </span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="Queue"[% END %][% IF Data.FlexEditQueue %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                    <label>[% Translate("Queue") | html %]:[% IF Data.QueueValidID != 1 %] <em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                    <p class="Value[% IF Data.FlexEditQueue %] FlexEditable[% END %]" title="[% Data.Queue | html %]"[% IF Data.FlexEditQueue %] data-flexedit-field="Queue" data-flexedit-value="[% Data.QueueID | html %]"[% END %]>[% Data.Queue | html %]</p>
                                </span>
# ---

                                [% RenderBlockStart("Service") %]
# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                        <label>[% Translate("Service") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                        <p class="Value" title="[% Data.Service | html %]">[% Data.Service | html %]</p>
#                                    </span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="Service"[% END %][% IF Data.FlexEditService %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                        <label>[% Translate("Service") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                        <p class="Value[% IF Data.FlexEditService %] FlexEditable[% END %]" title="[% Data.Service | html %]"[% IF Data.FlexEditService %] data-flexedit-field="Service" data-flexedit-value="[% Data.ServiceID | html %]"[% END %]>[% IF Data.Service %][% Data.Service | html %][% ELSE %]-[% END %]</p>
                                    </span>
# ---
                                [% RenderBlockEnd("Service") %]
# ---
# Znuny-FlexEdit
# ---
                                [% IF Data.FlexEditActive && !Data.FlexEditServiceShown %]<span class="Hidden" data-flexedit-row="Service"></span>[% END %]
# ---

                                [% RenderBlockStart("SLA") %]
# ---
# Znuny-FlexEdit
# ---
#                                <span>
#                                        <label>[% Translate("Service Level Agreement") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                        <p class="Value" title="[% Data.SLA | html %]">[% Data.SLA | html %]</p>
#                                    </span>
                                <span[% IF Data.FlexEditActive %] data-flexedit-row="SLA"[% END %][% IF Data.FlexEditSLA %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                        <label>[% Translate("Service Level Agreement") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                        <p class="Value[% IF Data.FlexEditSLA %] FlexEditable[% END %]" title="[% Data.SLA | html %]"[% IF Data.FlexEditSLA %] data-flexedit-field="SLA" data-flexedit-value="[% Data.SLAID | html %]"[% END %]>[% IF Data.SLA %][% Data.SLA | html %][% ELSE %]-[% END %]</p>
                                    </span>
# ---
                                [% RenderBlockEnd("SLA") %]
# ---
# Znuny-FlexEdit
# ---
                                [% IF Data.FlexEditActive && !Data.FlexEditSLAShown %]<span class="Hidden" data-flexedit-row="SLA"></span>[% END %]

# Owner and responsible are moved here (from the customer section below), so that all editable attributes are next to each other.
                                [% RenderBlockStart("Owner") %]
                                    <span[% IF Data.FlexEditActive %] data-flexedit-row="Owner"[% END %][% IF Data.FlexEditOwner %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                        <label>[% Translate("Owner") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                        <p class="Value[% IF Data.FlexEditOwner %] FlexEditable[% END %]" title="[% Data.UserFullname | html %] ([% Data.UserLogin | html %])"[% IF Data.FlexEditOwner %] data-flexedit-field="Owner" data-flexedit-value="[% Data.OwnerID | html %]"[% END %]>
                                            [% Data.UserFullname | html %]
                                        </p>
                                    </span>
                                [% RenderBlockEnd("Owner") %]

                                [% RenderBlockStart("Responsible") %]
                                    <span[% IF Data.FlexEditActive %] data-flexedit-row="Responsible"[% END %][% IF Data.FlexEditResponsible %] class="FlexEditableRow" tabindex="0" role="button"[% END %]>
                                        <label>[% Translate("Responsible") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
                                        <p class="Value[% IF Data.FlexEditResponsible %] FlexEditable[% END %]" title="[% Data.UserFullname | html %] ([% Data.UserLogin | html %])"[% IF Data.FlexEditResponsible %] data-flexedit-field="Responsible" data-flexedit-value="[% Data.ResponsibleID | html %]"[% END %]>
                                            [% Data.UserFullname | html %]
                                        </p>
                                    </span>
                                [% RenderBlockEnd("Responsible") %]
# ---
                            </fieldset>

                            <fieldset class="TableLike FixedLabelSmall Narrow">
                                [% RenderBlockStart("FirstResponseTime") %]
                                <span>
                                        <label>[% Translate("First Response Time") | html %]:</label>
                                        <div class="Value">
                                            <p title="[% Translate("Service Time") | html %]: [% Data.FirstResponseTimeWorkingTime | html %]" class="[% Data.FirstResponseTimeClass | html %]">
                                                [% Data.FirstResponseTimeHuman | html %]
                                                <br/>
                                                [% Data.FirstResponseTimeDestinationDate | Localize("TimeShort") %]
                                            </p>
                                        </div>
                                    </span>
                                [% RenderBlockEnd("FirstResponseTime") %]

                                [% RenderBlockStart("UpdateTime") %]
                                <span>
                                        <label>[% Translate("Update Time") | html %]:</label>
                                        <div class="Value">
                                            <p title="[% Translate("Service Time") | html %]: [% Data.UpdateTimeWorkingTime | html %]" class="[% Data.UpdateTimeClass | html %]">
                                                [% Data.UpdateTimeHuman | html %]
                                                <br/>
                                                [% Data.UpdateTimeDestinationDate | Localize("TimeShort") %]
                                            </p>
                                        </div>
                                    </span>
                                [% RenderBlockEnd("UpdateTime") %]

                                [% RenderBlockStart("SolutionTime") %]
                                <span>
                                        <label>[% Translate("Solution Time") | html %]:</label>
                                        <div class="Value">
                                            <p title="[% Translate("Service Time") | html %]: [% Data.SolutionTimeWorkingTime | html %]" class="[% Data.SolutionTimeClass | html %]">
                                                [% Data.SolutionTimeHuman | html %]
                                                <br/>
                                                [% Data.SolutionTimeDestinationDate | Localize("TimeShort") %]
                                            </p>
                                        </div>
                                    </span>
                                [% RenderBlockEnd("SolutionTime") %]
                            </fieldset>

                            <fieldset class="TableLike FixedLabelSmall Narrow">
                                <span>
                                    <label>[% Translate("Customer ID") | html %]:</label>
                                    <p class="Value">
                                        [% RenderBlockStart("CustomerIDRW") %]
                                            <a href="[% Config("CustomerDBLink") | Interpolate %]" class="[% Config("CustomerDBLinkClass") | html %]" [% Config("CustomerDBLinkTarget") %]>[% Data.CustomerID | html %]</a>
                                        [% RenderBlockEnd("CustomerIDRW") %]
                                        [% RenderBlockStart("CustomerIDRO") %]
                                            [% Data.CustomerID | html %]
                                        [% RenderBlockEnd("CustomerIDRO") %]

                                        [% RenderBlockStart("CustomerIDTickets") %]
                                        &nbsp;-&nbsp;
                                            <a href="[% Env("Baselink") %]Action=AgentTicketSearch;Subaction=Search;CustomerID=[% Data.CustomerID | uri %];StateType=Open" title="[% Translate('Open tickets') | html %]">
                                                [% Translate('Open tickets') | html %]: [% Data.CustomerIDTickets %]
                                            </a>
                                        [% RenderBlockEnd("CustomerIDTickets") %]
                                    </p>
                                </span>

                                [% RenderBlockStart("TotalAccountedTime") %]
                                    <span>
                                        <label>[% Translate("Accounted time") | html %]:</label>
                                        <p class="Value">[% Data.TicketTimeUnits %]</p>
                                    </span>
                                [% RenderBlockEnd("TotalAccountedTime") %]

# ---
# Znuny-FlexEdit
# ---
#                                [% RenderBlockStart("Owner") %]
#                                    <span>
#                                        <label>[% Translate("Owner") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                        <p class="Value" title="[% Data.UserFullname | html %] ([% Data.UserLogin | html %])">
#                                            [% Data.UserFullname | html %]
#                                        </p>
#                                    </span>
#                                [% RenderBlockEnd("Owner") %]
#
#                                [% RenderBlockStart("Responsible") %]
#                                    <span>
#                                        <label>[% Translate("Responsible") | html %]: [% IF Data.ValidID != 1 %]<em class="Error">[% Translate("is invalid") | html %]!</em> [% END %]</label>
#                                        <p class="Value" title="[% Data.UserFullname | html %] ([% Data.UserLogin | html %])">
#                                            [% Data.UserFullname | html %]
#                                        </p>
#                                    </span>
#                                [% RenderBlockEnd("Responsible") %]
# ---
                            </fieldset>

                            [% RenderBlockStart("ProcessData") %]
                            <fieldset class="TableLike FixedLabelSmall Narrow">

                                <span>
                                    <label>[% Translate("Process") | html %]:</label>
                                    <p class="Value" title="[% Translate(Data.Process) | html %]">[% Translate(Data.Process) | html %]</p>
                                </span>

                                <span>
                                    <label>[% Translate("Activity") | html %]:</label>
                                    <p class="Value" title="[% Translate(Data.Activity) | html %]">[% Translate(Data.Activity) | html %]</p>
                                </span>
                            </fieldset>
                            [% RenderBlockEnd("ProcessData") %]
                            <fieldset class="TableLike FixedLabelSmall Narrow">
                                [% RenderBlockStart("TicketDynamicField") %]
                                <span>
                                        <label>[% Translate(Data.Label) | html %]:</label>
                                        <p class="Value">
                                        [% RenderBlockStart("TicketDynamicFieldLink") %]
                                            <span title="[% Data.Title %]"><a href="[% Data.Link | Interpolate %]" [% IF Data.LinkPreview %] data-trigger="floater" data-floater-url="[% Data.LinkPreview | Interpolate %]" [% END %] target="_blank" class="DynamicFieldLink">[% Data.Value %]</a></span>
                                        [% RenderBlockEnd("TicketDynamicFieldLink") %]

                                        [% RenderBlockStart("TicketDynamicFieldPlain") %]
                                            <span title="[% Data.Title %]">[% Data.Value %]</span>
                                        [% RenderBlockEnd("TicketDynamicFieldPlain") %]
                                        </p>
                                    </span>
                                [% RenderBlockEnd("TicketDynamicField") %]
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
